{
  "manifest_version": 3,
  "name": "Kyoto — AI browser agent for developers",
  "version": "7.1.0",
  "description": "AI browser agent for devs. BYOK any OpenAI-compat provider (OpenRouter / DeepSeek / MiniMax / Ollama / Groq / ...). Per-tab sessions, slash commands, cross-session memory, MCP servers, ~35 dev tools.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "tabs",
    "cookies",
    "webRequest",
    "webNavigation",
    "history",
    "bookmarks",
    "downloads",
    "notifications",
    "clipboardWrite",
    "alarms",
    "debugger"
  ],
  "optional_permissions": [
    "clipboardRead",
    "management",
    "topSites"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Kyoto",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Kyoto side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
