{
  "manifest_version": 3,
  "name": "Kyoto \u2014 AI browser agent for developers",
  "version": "14.51.0",
  "description": "AI browser agent for devs. BYOK any OpenAI-compat provider (OpenRouter / OpenCode Go / DeepSeek / MiniMax / Ollama / Groq / ...). Per-tab sessions, slash commands, cross-session memory, MCP servers, ~35 dev tools.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "tabs",
    "cookies",
    "webRequest",
    "history",
    "bookmarks",
    "downloads",
    "notifications",
    "clipboardWrite",
    "alarms",
    "debugger",
    "nativeMessaging",
    "tabGroups",
    "sessions",
    "power",
    "pageCapture",
    "browsingData",
    "readingList",
    "idle",
    "omnibox",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Kyoto",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "devtools_page": "devtools/devtools.html",
  "sandbox": {
    "pages": [
      "sandbox/python.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-eval' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net blob:; connect-src 'self' https://cdn.jsdelivr.net https: data: blob:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Kyoto side panel"
    }
  },
  "omnibox": {
    "keyword": "ky"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
