{
  "manifest_version": 3,
  "name": "PageChat — OpenRouter & DeepSeek",
  "version": "3.0.0",
  "description": "Ask any AI model about the current page. Bring your own OpenRouter or DeepSeek key — pick from hundreds of models.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open PageChat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open PageChat side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
